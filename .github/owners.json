                "AGENTS.md", "CLAUDE.md", "README.md", ".gitignore", ".env.example"]
    },
    "P2": {"name": "Ingest", "paths": ["ingest/"]},
    "P3": {"name": "Reference and coverage", "paths": ["reference/", "coverage/"]},
    "P4": {"name": "Detect and match", "paths": ["detect/", "match/"]},
    "P5": {"name": "Aggregate and forecast", "paths": ["aggregate/", "forecast/"]},
    "P6": {"name": "Detectors and fuse", "paths": ["detectors/", "fuse/"]},
    "P7": {"name": "Patrol, export, dashboard, pitch", "paths": ["patrol/", "export/", "dashboard/", "pitch/"]}
  },
  "network_allowed": ["P2"],
  "github_users": {
    "P1": "LiamLiamFitzgerald", "P2": "JDonoghue-UL", "P3": "Coneill2026", "P4": "DandarGaming",
    "P5": "conorwalsh-1", "P6": "CaptainJDawg", "P7": "Pint-Sized"
  }
