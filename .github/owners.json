{
  "_comment": "Single source of truth for who may edit what. Used by the Claude Code guard hook, the CI path check and the CODEOWNERS generator. Paths ending in / are folders.",
  "shared": ["STATUS.md", "DECISIONS.md"],
  "modules": {
    "P1": {
      "name": "Core, simulator, validation, CI",
      "paths": ["core/", "sim/", "validate/", "reports/", "docs/", "scripts/", ".github/", ".claude/",
