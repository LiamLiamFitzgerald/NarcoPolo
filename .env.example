# Copy to .env (never commit .env). Only P2 (ingest) needs the data tokens.

# Global Fishing Watch API token (https://globalfishingwatch.org/our-apis/)
GFW_TOKEN=

# Copernicus Climate Data Store key for ERA5 (cdsapi)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Copernicus Data Space Ecosystem: openEO logs in interactively (OIDC) on first use;
# set these only if you use client credentials
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Salt for hashing ship ids (P4). Any long random string; same value for the whole team
SHIP_KEY_SALT=
