#!/usr/bin/env bash
# 1. Strip AI attribution lines: commits are credited to the human who made them.
# 2. On mod/p<n>/... branches, prefix the subject with [P<n>] so the team can see which agent made it.
msg="$1"
sed -i.bak -E '/^Co-[Aa]uthored-[Bb]y: .*(Claude|anthropic)/d; /Generated with .*Claude/d; /^Claude-Session:/d' "$msg" && rm -f "$msg.bak"

# The module comes from scripts/narco_module.py, the same function the guard and CI use (#182).
module=$(uv run --no-project python "$(git rev-parse --show-toplevel)/scripts/narco_module.py" 2>/dev/null || true)
if [[ -n "$module" ]]; then
  tag="[${module}]"
  first=$(head -n1 "$msg")
  if [[ "$first" != "$tag"* ]]; then
    { echo "$tag $first"; tail -n +2 "$msg"; } > "$msg.tmp" && mv "$msg.tmp" "$msg"
  fi
fi
